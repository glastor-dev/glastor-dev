{
  "name": "@glastor-dev/readmegen",
  "version": "2.2.0",
  "description": "Professional README Generator for Deno projects with interactive CLI and GitHub Actions integration.",
  "license": "GPL-3.0-only",
  "exports": "./src/mod.ts",
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "deno.json",
      "src/**/*.ts",
      "src/templates/*.md"
    ]
  },
  "nodeModulesDir": "auto",
  "lint": {
    "rules": {
      "exclude": [
        "no-import-prefix",
        "no-unversioned-import"
      ]
    },
    "exclude": [
      "README.generated.md",
      "README.md.bak",
      "README.md",
      "README.profile.md",
      "node_modules",
      "dist",
      "build"
    ]
  },
  "fmt": {
    "exclude": [
      "README.generated.md",
      "README.md.bak",
      "README.md",
      "README.profile.md",
      "src/templates",
      "node_modules",
      "dist",
      "build"
    ],
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "proseWrap": "preserve"
  },
  "tasks": {
    "readme": "deno run --allow-read --allow-write --allow-env src/main.ts --output README.md",
    "readme:force": "deno run --allow-read --allow-write --allow-env src/main.ts --output README.md --force",
    "readme:check": "deno run --allow-read --allow-write --allow-env src/main.ts --output README.generated.md --force",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check src/main.ts",
    "test": "deno test --allow-read --allow-write --allow-env",
    "bench": "deno bench --allow-read --allow-write --allow-env --lock=deno.lock",
    "spell:check": "npx cspell \"**/*.md\"",
    "spell:add": "deno run --allow-run --allow-read --allow-write scripts/spell_add.ts"
  },
  "imports": {
    "@cspell/dict-es-es": "npm:@cspell/dict-es-es@^3.0.9"
  }
}
